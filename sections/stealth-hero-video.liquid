<div class="stealth-hero-video color-{{ section.settings.color_scheme }} gradient" style="--hero-min-height: {{ section.settings.min_height }}px; --hero-overlay-alpha: {{ section.settings.overlay_opacity | default: 75 }}%;">
  <div class="stealth-hero-video__media">
    {%- if section.settings.video_url != blank -%}
      <video
        class="stealth-hero-video__video"
        autoplay
        muted
        loop
        playsinline
        poster="{{ section.settings.cover_image | image_url: width: 1920 }}"
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.cover_image != blank -%}
      <img
        class="stealth-hero-video__image"
        src="{{ section.settings.cover_image | image_url: width: 1920 }}"
        alt="{{ section.settings.cover_image.alt | default: section.settings.heading }}"
        loading="eager"
        width="1920"
        height="{{ 1920 | divided_by: section.settings.cover_image.aspect_ratio | round }}"
      >
    {%- else -%}
      <div class="stealth-hero-video__placeholder"></div>
    {%- endif -%}

  </div>

  <div class="stealth-hero-video__content page-width">
    {%- if section.settings.subheading != blank -%}
      <span class="stealth-hero-video__subheading">{{ section.settings.subheading }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="stealth-hero-video__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="stealth-hero-video__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="stealth-hero-video__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary stealth-hero-video__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_button_label != blank -%}
        <a href="{{ section.settings.secondary_button_link }}" class="button button--secondary stealth-hero-video__btn stealth-hero-video__btn--secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          {{ section.settings.secondary_button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>

</div>

<style>
  .stealth-hero-video {
    position: relative;
    min-height: var(--hero-min-height, 600px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .stealth-hero-video::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(8, 8, 10, 0.75);
    background-color: rgb(8 8 10 / var(--hero-overlay-alpha, 75%));
    z-index: 1;
    pointer-events: none;
  }

  .stealth-hero-video__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .stealth-hero-video__video,
  .stealth-hero-video__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stealth-hero-video__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1f1f21 0%, #2a2a2e 50%, #1f1f21 100%);
  }

  .stealth-hero-video__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 980px;
    padding: 5rem 1.5rem;
  }

  .stealth-hero-video__subheading {
    display: inline-block;
    font-family: var(--font-heading-family);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--color-button);
    margin-bottom: 1.5rem;
    padding: 0.65rem 1.3rem;
    border: 2px solid var(--color-button);
    border-radius: 2px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
  }

  .stealth-hero-video__heading {
    font-family: var(--font-heading-family);
    font-weight: 800 !important;
    text-transform: uppercase;
    line-height: 1.02 !important;
    margin: 0 0 1.75rem !important;
    letter-spacing: -0.01em;
    text-shadow:
      -1px -1px 0 #fff,
      1px -1px 0 #fff,
      -1px 1px 0 #fff,
      1px 1px 0 #fff,
      0 2px 24px rgba(0, 0, 0, 0.55);
  }

  .stealth-hero-video__heading.h0 { font-size: clamp(3.75rem, 8.5vw, 7rem) !important; }
  .stealth-hero-video__heading.h1 { font-size: clamp(3rem, 7vw, 5.5rem) !important; }

  .stealth-hero-video__text {
    font-size: clamp(1.5rem, 2.1vw, 1.85rem) !important;
    max-width: 780px;
    margin: 0 auto 2.5rem;
    line-height: 1.5;
    font-weight: 500;
    text-shadow:
      -1px -1px 0 rgba(255, 255, 255, 0.85),
      1px -1px 0 rgba(255, 255, 255, 0.85),
      -1px 1px 0 rgba(255, 255, 255, 0.85),
      1px 1px 0 rgba(255, 255, 255, 0.85),
      0 1px 12px rgba(0, 0, 0, 0.55);
  }

  .stealth-hero-video__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .stealth-hero-video__btn {
    min-width: 180px;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .stealth-hero-video__btn--secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media screen and (max-width: 749px) {
    .stealth-hero-video {
      min-height: 520px;
    }

    .stealth-hero-video__content {
      padding: 3rem 1.25rem;
    }

    .stealth-hero-video__subheading {
      font-size: 1rem;
      letter-spacing: 0.18em;
      padding: 0.55rem 1rem;
    }

    .stealth-hero-video__text {
      font-size: 1.25rem !important;
      line-height: 1.5;
    }

    .stealth-hero-video__actions {
      flex-direction: column;
      align-items: center;
    }

    .stealth-hero-video__btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>

{% schema %}
{
  "name": "Stealth Hero Video",
  "tag": "section",
  "class": "section section--full-width",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading badge",
      "default": "THE CHAIR BEHIND THE SOUND"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ENGINEERED FOR THE PEOPLE WHO ENGINEER THE SOUND"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h0", "label": "Extra Large" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h0"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "From the studio to the stage — patented ZenWave technology and custom-fit ergonomic design trusted by the world's top engineers."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "FIND YOUR STEALTH"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "WATCH THE STORY"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (MP4 hosted file)"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image / fallback"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0,
      "max": 95,
      "step": 5,
      "default": 70,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 400,
      "max": 900,
      "step": 50,
      "default": 650,
      "unit": "px"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Stealth Hero Video"
    }
  ]
}
{% endschema %}
