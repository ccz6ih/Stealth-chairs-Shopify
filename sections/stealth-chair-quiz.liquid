    };

    var questions = [
      {
        text: "What's your primary use for the chair?",
        educational: "Different professions require unique support. Audio engineers lean forward 23% more than typical office workers, requiring specialized lumbar support that moves with them.",
        options: [
          { text: "Music production / audio engineering", value: "audio" },
          { text: "Live sound / FOH engineering", value: "live" },
          { text: "Video / post production", value: "video" },
          { text: "Lighting design / control", value: "lighting" },
          { text: "Other studio / creative work", value: "other" }
        ]
      },
      {
        text: "How many hours do you typically spend sitting per day?",
        educational: "After 4 hours of sitting, spinal disc pressure increases by 40%. ZenWave technology reduces this pressure by allowing natural movement.",
        options: [
          { text: "2-4 hours", value: "short" },
          { text: "4-6 hours", value: "medium" },
          { text: "6-8 hours", value: "long" },
          { text: "8+ hours (marathon sessions)", value: "marathon" }
