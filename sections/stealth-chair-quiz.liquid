<div class="stealth-chair-quiz color-{{ section.settings.color_scheme }} gradient" data-stealth-quiz="{{ section.id }}">
  <div class="stealth-chair-quiz__inner page-width">
    <div class="stealth-chair-quiz__card">
      <div class="stealth-chair-quiz__intro">
        {%- if section.settings.subheading != blank -%}
          <span class="stealth-chair-quiz__subheading">{{ section.settings.subheading }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="stealth-chair-quiz__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro_text != blank -%}
          <p class="stealth-chair-quiz__lede">{{ section.settings.intro_text }}</p>
        {%- endif -%}

        {%- if section.settings.highlight_text != blank -%}
          <div class="stealth-chair-quiz__highlight">
            <svg class="stealth-chair-quiz__highlight-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 12c0-3 2.5-6 6-6s4 3 4 6-2.5 6-4 6"/>
              <path d="M22 12c0-3-2.5-6-6-6s-4 3-4 6 2.5 6 4 6"/>
            </svg>
            <span>{{ section.settings.highlight_text }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="stealth-chair-quiz__quiz" data-quiz-content>
        <div class="stealth-chair-quiz__progress-wrap">
          <div class="stealth-chair-quiz__progress">
            <div class="stealth-chair-quiz__progress-bar" data-progress-bar style="width: 0%"></div>
          </div>
          <div class="stealth-chair-quiz__progress-text">
            Question <span data-current-q>1</span> of <span data-total-q>9</span>
          </div>
        </div>

        <div class="stealth-chair-quiz__question">
          <h3 class="stealth-chair-quiz__question-text" data-question-text>&nbsp;</h3>
          <div class="stealth-chair-quiz__educational" data-educational></div>
        </div>

        <div class="stealth-chair-quiz__options" data-options-container></div>
      </div>

      <div class="stealth-chair-quiz__result" data-result-content hidden></div>
    </div>
  </div>
</div>

<style>
  .stealth-chair-quiz {
    --quiz-accent: #FF0000;
    padding: 4rem 0;
    color: #ffffff;
  }

  .stealth-chair-quiz__inner {
    max-width: 960px;
  }

  .stealth-chair-quiz__card {
    padding: 3rem 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.5);
    color: #ffffff;
  }

  .stealth-chair-quiz__intro {
    text-align: center;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--quiz-accent);
  }

  .stealth-chair-quiz__subheading {
    display: inline-block;
    font-family: var(--font-heading-family);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--quiz-accent);
    margin-bottom: 1rem;
  }

  .stealth-chair-quiz__heading {
    font-family: var(--font-heading-family);
    text-transform: uppercase;
    margin: 0 0 1rem;
    line-height: 1.1;
    color: #ffffff;
  }

  .stealth-chair-quiz__lede {
    font-size: 1.125rem;
    color: #ffffff;
    opacity: 0.9;
    margin: 0 0 1.5rem;
    line-height: 1.55;
  }

  .stealth-chair-quiz__highlight {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 0, 0, 0.08);
    border-left: 3px solid var(--quiz-accent);
    padding: 1rem 1.25rem;
    margin-top: 0.5rem;
    text-align: left;
    font-size: 1rem;
    border-radius: 0 4px 4px 0;
    color: #ffffff;
  }

  .stealth-chair-quiz__highlight-icon {
    color: var(--quiz-accent);
    flex-shrink: 0;
  }

  .stealth-chair-quiz__progress-wrap {
    margin-bottom: 2rem;
  }

  .stealth-chair-quiz__progress {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
  }

  .stealth-chair-quiz__progress-bar {
    height: 100%;
    background: var(--quiz-accent);
    border-radius: 3px;
    transition: width 0.4s ease;
  }

  .stealth-chair-quiz__progress-text {
    text-align: center;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.75;
    margin-top: 0.875rem;
    font-family: var(--font-heading-family);
    color: #ffffff;
  }

  .stealth-chair-quiz__question-text {
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    line-height: 1.25;
    margin: 0 0 1.25rem;
    font-weight: 700;
    color: #ffffff;
  }

  .stealth-chair-quiz__educational {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 1.125rem 1.25rem;
    margin-bottom: 1.75rem;
    font-size: 1rem;
    line-height: 1.55;
    color: #ffffff;
  }

  .stealth-chair-quiz__educational-icon {
    color: var(--quiz-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .stealth-chair-quiz__options {
    display: grid;
    gap: 0.75rem;
  }

  .stealth-chair-quiz__option {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-family: inherit;
    padding: 1.125rem 1.375rem;
    border-radius: 4px;
    cursor: pointer;
    text-align: left;
    width: 100%;
    transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.18s ease;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .stealth-chair-quiz__option:hover,
  .stealth-chair-quiz__option:focus-visible {
    border-color: var(--quiz-accent);
    background: rgba(255, 0, 0, 0.08);
    outline: none;
    transform: translateY(-1px);
  }

  .stealth-chair-quiz__result {
    animation: stealthQuizFade 0.45s ease;
  }

  @keyframes stealthQuizFade {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .stealth-chair-quiz__result-header {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    margin-bottom: 2rem;
    text-align: center;
    color: #ffffff;
  }

  .stealth-chair-quiz__result-eyebrow {
    display: inline-block;
    font-family: var(--font-heading-family);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--quiz-accent);
    margin-bottom: 0.5rem;
  }

  .stealth-chair-quiz__result-model {
    display: block;
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    text-transform: uppercase;
    margin: 0.25rem 0 0.75rem;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .stealth-chair-quiz__result-fit {
    font-size: 1.0625rem;
    color: #ffffff;
    opacity: 0.85;
    margin: 0;
  }

  .stealth-chair-quiz__result-grid {
    display: grid;
    gap: 1.25rem;
  }

  .stealth-chair-quiz__info-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 1.75rem;
    color: #ffffff;
    font-size: 1rem;
  }

  .stealth-chair-quiz__info-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-heading-family);
    color: var(--quiz-accent);
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1rem;
  }

  .stealth-chair-quiz__info-title svg {
    flex-shrink: 0;
  }

  .stealth-chair-quiz__info-card p {
    margin: 0 0 0.75rem;
    line-height: 1.55;
    font-size: 1rem;
  }

  .stealth-chair-quiz__info-card ul {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    line-height: 1.6;
    font-size: 1rem;
  }

  .stealth-chair-quiz__info-card li {
    margin-bottom: 0.5rem;
  }

  .stealth-chair-quiz__testimonial {
    margin-top: 1.25rem;
    padding: 1.125rem 1.375rem;
    background: rgba(255, 0, 0, 0.05);
    border-left: 3px solid var(--quiz-accent);
    border-radius: 0 4px 4px 0;
    font-style: italic;
    line-height: 1.6;
    font-size: 1rem;
    color: #ffffff;
  }

  .stealth-chair-quiz__testimonial-author {
    display: block;
    text-align: right;
    margin-top: 0.625rem;
    color: var(--quiz-accent);
    font-style: normal;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .stealth-chair-quiz__compare {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.5rem;
    font-size: 1rem;
    color: #ffffff;
  }

  .stealth-chair-quiz__compare th {
    text-align: left;
    padding: 0.875rem 1rem;
    font-family: var(--font-heading-family);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--quiz-accent);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .stealth-chair-quiz__compare td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    vertical-align: top;
    font-size: 1rem;
  }

  .stealth-chair-quiz__compare-cell {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .stealth-chair-quiz__compare-cell--yes {
    color: #ffffff;
  }

  .stealth-chair-quiz__compare-cell--yes svg {
    color: var(--quiz-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .stealth-chair-quiz__compare-cell--no {
    color: rgba(255, 255, 255, 0.55);
  }

  .stealth-chair-quiz__compare-cell--no svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .stealth-chair-quiz__compare-wrap {
    overflow-x: auto;
  }

  .stealth-chair-quiz__specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .stealth-chair-quiz__spec {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1rem;
    border-radius: 4px;
    text-align: center;
  }

  .stealth-chair-quiz__spec-label {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.75;
    margin-bottom: 0.375rem;
    color: #ffffff;
  }

  .stealth-chair-quiz__spec-value {
    font-size: 1.125rem;
    font-weight: 700;
    color: #ffffff;
  }

  .stealth-chair-quiz__roi {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin: 1rem 0 0.75rem;
  }

  .stealth-chair-quiz__roi-item {
    text-align: center;
  }

  .stealth-chair-quiz__roi-value {
    display: block;
    font-family: var(--font-heading-family);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: var(--quiz-accent);
    line-height: 1;
  }

  .stealth-chair-quiz__roi-label {
    display: block;
    font-size: 1rem;
    opacity: 0.85;
    margin-top: 0.5rem;
    color: #ffffff;
  }

  .stealth-chair-quiz__buttons {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .stealth-chair-quiz__btn {
    flex: 1;
    min-width: 200px;
    padding: 1rem 1.5rem;
    border-radius: 4px;
    font-size: 1rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
    font-family: inherit;
    line-height: 1;
  }

  .stealth-chair-quiz__btn--primary {
    background: var(--quiz-accent);
    color: #ffffff;
    border: 2px solid var(--quiz-accent);
  }

  .stealth-chair-quiz__btn--primary:hover,
  .stealth-chair-quiz__btn--primary:focus-visible {
    background: #cc0000;
    border-color: #cc0000;
    transform: translateY(-1px);
    outline: none;
  }

  .stealth-chair-quiz__btn--secondary {
    background: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
  }

  .stealth-chair-quiz__btn--secondary:hover,
  .stealth-chair-quiz__btn--secondary:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-1px);
    outline: none;
  }

  .stealth-chair-quiz__guarantee {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .stealth-chair-quiz__guarantee-title {
    font-family: var(--font-heading-family);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    margin: 0 0 1rem;
    color: #ffffff;
    opacity: 0.85;
  }

  .stealth-chair-quiz__guarantee-list {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .stealth-chair-quiz__guarantee-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: #ffffff;
  }

  .stealth-chair-quiz__guarantee-item svg {
    color: var(--quiz-accent);
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .stealth-chair-quiz {
      padding: 2.5rem 0;
    }

    .stealth-chair-quiz__card {
      padding: 1.75rem 1.25rem;
    }

    .stealth-chair-quiz__buttons {
      flex-direction: column;
    }

    .stealth-chair-quiz__btn {
      width: 100%;
      min-width: 0;
    }
  }
</style>

<script>
  (function () {
    var root = document.querySelector('[data-stealth-quiz="{{ section.id }}"]');
    if (!root) return;

    var ICONS = {
