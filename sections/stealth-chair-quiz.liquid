      },
      {
        text: "Do you need armrests for your work?",
        educational: "Many musicians prefer no armrests for instrument access. Our optional 4D armrests can be removed or adjusted completely out of the way.",
        options: [
          { text: "Yes, essential for support", value: "essential" },
          { text: "Nice to have, but removable", value: "optional" },
          { text: "No, they get in the way", value: "no" },
          { text: "Depends on the task", value: "flexible" }
        ]
      },
      {
        text: "Where will you primarily use this chair?",
        educational: "Different environments need different features. Home studios benefit from style, while commercial facilities need maximum durability.",
        options: [
          { text: "Home studio", value: "home" },
          { text: "Commercial studio", value: "commercial" },
          { text: "Live venue / touring", value: "touring" },
          { text: "Multiple locations", value: "multiple" }
        ]
      }
    ];

    var testimonials = {
      audio: {
        quote: "After putting up with gaming chairs for years, the Stealth has been incredible. The forward tilt when mixing is a game-changer. My back pain is gone.",
        author: "James K., Audio Engineer"
      },
      live: {
        quote: "I've used this chair at FOH for 200+ shows. The portability and comfort during 14-hour festival days is unmatched. Worth every penny.",
        author: "Sarah M., FOH Engineer"
      },
      health: {
        quote: "As a studio owner, I bought 6 Stealth chairs. My engineers' productivity is up, sick days are down. Best investment I've made.",
        author: "Mike D., Studio Owner"
      }
    };

    var products = {
      stealthStandard: { url: "/products/stealth-standard-chair-midnight-black-standard-size-seat", price: 599 },
      stealthPro: { url: "/products/stealth-pro-chair-midnight-black-large-size-seat", price: 799 },
      stealthExecutive: { url: "/products/stealth-executive-audio-engineer-chair", price: 649 },
      stealthProExecutive: { url: "/products/stealth-pro-executive-audio-engineer-chair", price: 749 }
    };

    var currentQuestion = 0;
    var answers = {};

    var quizContent = root.querySelector('[data-quiz-content]');
    var resultContent = root.querySelector('[data-result-content]');
    var questionText = root.querySelector('[data-question-text]');
    var educational = root.querySelector('[data-educational]');
    var optionsContainer = root.querySelector('[data-options-container]');
    var progressBar = root.querySelector('[data-progress-bar]');
    var currentQEl = root.querySelector('[data-current-q]');
    var totalQEl = root.querySelector('[data-total-q]');

    function updateProgress() {
      var pct = ((currentQuestion + 1) / questions.length) * 100;
      progressBar.style.width = pct + '%';
      currentQEl.textContent = currentQuestion + 1;
      totalQEl.textContent = questions.length;
    }

    function showQuestion() {
      var q = questions[currentQuestion];
      questionText.textContent = q.text;
      educational.innerHTML =
        '<span class="stealth-chair-quiz__educational-icon">' + ICONS.info + '</span>' +
        '<span>' + q.educational + '</span>';

      optionsContainer.innerHTML = '';
      q.options.forEach(function (option, index) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'stealth-chair-quiz__option';
        btn.textContent = option.text;
        btn.addEventListener('click', function () { handleAnswer(option.value, option.text); });
        btn.style.opacity = '0';
        btn.style.transform = 'translateY(12px)';
        setTimeout(function () {
          btn.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
          btn.style.opacity = '1';
          btn.style.transform = 'translateY(0)';
        }, index * 50);
        optionsContainer.appendChild(btn);
      });

      updateProgress();
    }

    function handleAnswer(value, text) {
      answers[currentQuestion] = { value: value, text: text };
      if (currentQuestion < questions.length - 1) {
        currentQuestion++;
        showQuestion();
      } else {
        showResult();
      }
    }

    function calculateChairFit() {
      var heightScore = {
        under56: { standard: 10, pro: 7 },
        average: { standard: 10, pro: 10 },
        tall: { standard: 7, pro: 10 },
        very_tall: { standard: 5, pro: 10 }
      };
      var weightScore = {
        under150: { standard: 10, pro: 8 },
        average_weight: { standard: 10, pro: 10 },
        above_average: { standard: 7, pro: 10 },
        heavy: { standard: 5, pro: 10 }
      };
      var height = answers[4].value;
      var weight = answers[5].value;
      return {
        standardFit: (heightScore[height].standard + weightScore[weight].standard) / 2,
        proFit: (heightScore[height].pro + weightScore[weight].pro) / 2
      };
    }

    function getRecommendation() {
      var fit = calculateChairFit();
      var needsPro = fit.proFit > fit.standardFit && fit.standardFit < 8;
      var leansForward = ['constant', 'frequent'].indexOf(answers[6].value) !== -1;
      var longHours = ['long', 'marathon'].indexOf(answers[1].value) !== -1;
      var hasBackPain = answers[2].value === 'lower_back';
      var wantsExecutive = longHours || (hasBackPain && answers[1].value !== 'short');

      var model, url, price, dimensions, seatSize;
      if (needsPro) {
        model = wantsExecutive ? 'Stealth Pro Executive' : 'Stealth Pro';
        url = wantsExecutive ? products.stealthProExecutive.url : products.stealthPro.url;
        price = wantsExecutive ? products.stealthProExecutive.price : products.stealthPro.price;
        seatSize = 'Large';
        dimensions = { width: '20.25"', depth: '19.5"', seatHeight: '22"-28" (short) or 25"-32" (tall cylinder)' };
      } else {
        model = wantsExecutive ? 'Stealth Executive' : 'Stealth Standard';
        url = wantsExecutive ? products.stealthExecutive.url : products.stealthStandard.url;
        price = wantsExecutive ? products.stealthExecutive.price : products.stealthStandard.price;
        seatSize = 'Standard';
        dimensions = { width: '18.5"', depth: '16.75"', seatHeight: '19.5" (standard) or 25" (extended cylinder)' };
      }

      var cylinderRec = {
        under56: 'short / standard',
        average: 'standard',
        tall: 'tall / extended',
        very_tall: 'tall / extended'
      }[answers[4].value];

      return {
        model: model, url: url, price: price, seatSize: seatSize,
        dimensions: dimensions, cylinderRec: cylinderRec,
        leansForward: leansForward, wantsExecutive: wantsExecutive,
        fitScore: needsPro ? fit.proFit : fit.standardFit,
        userProfile: {
          use: answers[0].text, hours: answers[1].text, pain: answers[2].text,
          currentChair: answers[3].text, height: answers[4].text, weight: answers[5].text
        }
      };
    }

    function getComparison(currentChair) {
      var rows = {
        basic: [
          ['Forward tilt support', 'Patented ZenWave', 'Fixed position'],
          ['Lumbar support', 'Dynamic, follows movement', 'Static or none'],
          ['Build quality', '10-year warranty', '1-2 year typical'],
          ['Professional design', 'Studio-specific', 'Generic office']
        ],
        gaming: [
          ['Breathability', 'Mesh seat & back', 'Leather / pleather'],
          ['Ergonomic design', 'Research-based', 'Aesthetic-focused'],
          ['Forward work position', 'Optimized support', 'Forces upright'],
          ['Long-term comfort', '8+ hour sessions', '2-4 hours max']
        ],
        herman: [
          ['Audio-specific design', 'Console work optimized', 'Office-focused'],
          ['Forward tilt', 'Patented ZenWave', 'Limited or none'],
          ['Value', '$599-799', '$1,400+'],
          ['Musician-friendly', 'Armrest options', 'Fixed armrests']
        ]
      };
      var key = (currentChair === 'ergo' || currentChair === 'whatever') ? 'basic' : currentChair;
      return rows[key] || rows.basic;
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function showResult() {
      var rec = getRecommendation();
      var comparison = getComparison(answers[3].value);

      var testimonial = testimonials.audio;
      if (answers[0].value === 'live') testimonial = testimonials.live;
      else if (answers[2].value !== 'prevention') testimonial = testimonials.health;

      var dailyCost = (rec.price / (365 * 10)).toFixed(2);
      var chiropractorSavings = answers[2].value !== 'prevention' ? 2400 : 1200;
      var productivityGain = rec.leansForward ? '15%' : '10%';

      var fitLabel = rec.fitScore >= 9 ? 'Excellent fit' : 'Great fit';

      var compareRows = comparison.map(function (row) {
        return '<tr>' +
          '<td>' + escapeHtml(row[0]) + '</td>' +
          '<td><span class="stealth-chair-quiz__compare-cell stealth-chair-quiz__compare-cell--yes">' + ICONS.check + '<span>' + escapeHtml(row[1]) + '</span></span></td>' +
          '<td><span class="stealth-chair-quiz__compare-cell stealth-chair-quiz__compare-cell--no">' + ICONS.x + '<span>' + escapeHtml(row[2]) + '</span></span></td>' +
          '</tr>';
      }).join('');

      var html =
        '<div class="stealth-chair-quiz__result-header">' +
          '<span class="stealth-chair-quiz__result-eyebrow">Your perfect match</span>' +
          '<span class="stealth-chair-quiz__result-model">' + escapeHtml(rec.model) + '</span>' +
          '<p class="stealth-chair-quiz__result-fit">' + fitLabel + ' for your body type and work style</p>' +
        '</div>' +
        '<div class="stealth-chair-quiz__result-grid">' +
          '<div class="stealth-chair-quiz__info-card">' +
            '<h4 class="stealth-chair-quiz__info-title">' + ICONS.list + '<span>Why this chair</span></h4>' +
            '<p>Based on your ' + escapeHtml(rec.userProfile.hours.toLowerCase()) + ' of daily use in ' + escapeHtml(rec.userProfile.use.toLowerCase()) + ', ' +
              (rec.leansForward ? 'frequent forward-leaning work position, ' : '') +
              'and ' + escapeHtml(rec.userProfile.height.toLowerCase()) + ' height with ' + escapeHtml(rec.userProfile.weight.toLowerCase()) + ' build, the ' + escapeHtml(rec.model) + ' provides optimal support.</p>' +
            '<p>' + (rec.wantsExecutive
              ? '<strong>Executive backrest recommended:</strong> for your long sessions, the higher backrest provides crucial upper back and shoulder support, reducing fatigue during marathon work days.'
              : '<strong>Standard backrest recommended:</strong> perfect for your work style, providing excellent support while maintaining freedom of movement.') + '</p>' +
            '<blockquote class="stealth-chair-quiz__testimonial">' +
              escapeHtml(testimonial.quote) +
              '<span class="stealth-chair-quiz__testimonial-author">— ' + escapeHtml(testimonial.author) + '</span>' +
            '</blockquote>' +
          '</div>' +

          '<div class="stealth-chair-quiz__info-card">' +
            '<h4 class="stealth-chair-quiz__info-title">' + ICONS.wave + '<span>ZenWave technology benefits</span></h4>' +
            '<p>The patented ZenWave motion provides unbinding, stress-free support as you lean forward. The seat pivots with your body to maintain proper spinal alignment while the mesh surface dynamically redistributes pressure.</p>' +
            '<ul>' +
              '<li>Reduces disc pressure by up to 40% when leaning forward</li>' +
              '<li>Increases blood flow to prevent numbness</li>' +
              '<li>Maintains lumbar curve in all positions</li>' +
              '<li>Eliminates pressure points on tailbone and thighs</li>' +
            '</ul>' +
          '</div>' +

          '<div class="stealth-chair-quiz__info-card">' +
            '<h4 class="stealth-chair-quiz__info-title">' + ICONS.compare + '<span>' + escapeHtml(rec.model) + ' vs. your ' + escapeHtml(answers[3].text.toLowerCase()) + '</span></h4>' +
            '<div class="stealth-chair-quiz__compare-wrap">' +
              '<table class="stealth-chair-quiz__compare">' +
                '<thead><tr><th>Feature</th><th>Stealth ' + escapeHtml(rec.seatSize) + '</th><th>Current chair</th></tr></thead>' +
                '<tbody>' + compareRows + '</tbody>' +
              '</table>' +
            '</div>' +
          '</div>' +

          '<div class="stealth-chair-quiz__info-card">' +
            '<h4 class="stealth-chair-quiz__info-title">' + ICONS.ruler + '<span>Your specifications</span></h4>' +
            '<div class="stealth-chair-quiz__specs">' +
              '<div class="stealth-chair-quiz__spec"><span class="stealth-chair-quiz__spec-label">Seat size</span><span class="stealth-chair-quiz__spec-value">' + escapeHtml(rec.seatSize) + '</span></div>' +
              '<div class="stealth-chair-quiz__spec"><span class="stealth-chair-quiz__spec-label">Width</span><span class="stealth-chair-quiz__spec-value">' + escapeHtml(rec.dimensions.width) + '</span></div>' +
              '<div class="stealth-chair-quiz__spec"><span class="stealth-chair-quiz__spec-label">Depth</span><span class="stealth-chair-quiz__spec-value">' + escapeHtml(rec.dimensions.depth) + '</span></div>' +
              '<div class="stealth-chair-quiz__spec"><span class="stealth-chair-quiz__spec-label">Cylinder</span><span class="stealth-chair-quiz__spec-value">' + escapeHtml(rec.cylinderRec) + '</span></div>' +
            '</div>' +
            '<p style="margin-top: 1rem; opacity: 0.8;"><strong>Height range:</strong> ' + escapeHtml(rec.dimensions.seatHeight) + '<br><strong>Casters:</strong> both 2" office and 4" TourMax included</p>' +
          '</div>' +

          '<div class="stealth-chair-quiz__info-card">' +
            '<h4 class="stealth-chair-quiz__info-title">' + ICONS.coin + '<span>Your investment analysis</span></h4>' +
            '<div class="stealth-chair-quiz__roi">' +
              '<div class="stealth-chair-quiz__roi-item"><span class="stealth-chair-quiz__roi-value">$' + dailyCost + '</span><span class="stealth-chair-quiz__roi-label">Per day over 10 years</span></div>' +
              '<div class="stealth-chair-quiz__roi-item"><span class="stealth-chair-quiz__roi-value">$' + chiropractorSavings + '</span><span class="stealth-chair-quiz__roi-label">Annual health savings</span></div>' +
              '<div class="stealth-chair-quiz__roi-item"><span class="stealth-chair-quiz__roi-value">' + productivityGain + '</span><span class="stealth-chair-quiz__roi-label">Productivity gain</span></div>' +
            '</div>' +
            '<p style="text-align: center; opacity: 0.75; margin: 0;">Most users report the chair pays for itself within 4-6 months through reduced pain and increased productivity.</p>' +
          '</div>' +
        '</div>' +

        '<div class="stealth-chair-quiz__buttons">' +
          '<a href="' + escapeHtml(rec.url) + '" class="stealth-chair-quiz__btn stealth-chair-quiz__btn--primary">View ' + escapeHtml(rec.model) + ' ' + ICONS.arrow + '</a>' +
          '<button type="button" class="stealth-chair-quiz__btn stealth-chair-quiz__btn--secondary" data-restart>Start over</button>' +
        '</div>' +

        '<div class="stealth-chair-quiz__guarantee">' +
          '<h4 class="stealth-chair-quiz__guarantee-title">Your purchase is protected</h4>' +
          '<div class="stealth-chair-quiz__guarantee-list">' +
            '<div class="stealth-chair-quiz__guarantee-item">' + ICONS.check + '<span>30-day money-back guarantee</span></div>' +
            '<div class="stealth-chair-quiz__guarantee-item">' + ICONS.check + '<span>10-year warranty</span></div>' +
            '<div class="stealth-chair-quiz__guarantee-item">' + ICONS.check + '<span>Free shipping</span></div>' +
          '</div>' +
        '</div>';

      quizContent.hidden = true;
      resultContent.hidden = false;
      resultContent.innerHTML = html;

      var restart = resultContent.querySelector('[data-restart]');
      if (restart) restart.addEventListener('click', resetQuiz);

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'quiz_complete', {
          event_category: 'engagement',
          event_label: rec.model,
          value: rec.price
        });
      }
    }

    function resetQuiz() {
      currentQuestion = 0;
      answers = {};
      quizContent.hidden = false;
      resultContent.hidden = true;
      resultContent.innerHTML = '';
      showQuestion();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    showQuestion();
  })();
</script>

{% schema %}
{
  "name": "Stealth Chair Quiz",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow",
      "default": "60-SECOND FIT FINDER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND YOUR PERFECT STEALTH"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "intro_text",
      "label": "Intro text",
      "default": "Answer a few questions and we'll match you to the chair built for how you actually work."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight callout",
      "default": "Patented ZenWave technology — the only chair that moves with you."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Stealth Chair Quiz"
    }
  ]
}
{% endschema %}
